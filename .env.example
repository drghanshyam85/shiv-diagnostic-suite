# Copy to .env (or set in your host's dashboard). Everything is optional for a LAN install.
PORT=3000
HOST=0.0.0.0
# Database & uploaded files (keep this folder in your backups)
DATA_DIR=./data
# Session signing secret — generated into DATA_DIR/.jwt-secret if not set
JWT_SECRET=
# Start without sample patients / bills / reports on the very first run
DEMO_DATA=true
# Optional PostgreSQL instead of the built-in SQLite (also: npm install pg)
DATABASE_URL=
# Optional server-wide Gemini key (can also be entered in Settings → Integrations)
GEMINI_API_KEY=
# Optional SMTP fallback (Settings → Integrations takes precedence)
SMTP_USER=
SMTP_PASS=
# Optional LibreOffice path for server-side Word → PDF conversion
SOFFICE_PATH=
